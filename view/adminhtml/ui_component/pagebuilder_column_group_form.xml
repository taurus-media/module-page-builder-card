<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form_with_background_attributes">
    <fieldset name="general">
        <field name="tablet_layout" sortOrder="30" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1_column</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tablet Layout</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">slider</item>
                                <item name="label" xsi:type="string" translate="true">Slider</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">1_column</item>
                                <item name="label" xsi:type="string" translate="true">1 Column</item>
                            </option>
                            <option name="2" xsi:type="array">
                                <item name="value" xsi:type="string">2_columns</item>
                                <item name="label" xsi:type="string" translate="true">2 Columns</item>
                            </option>
                            <option name="3" xsi:type="array">
                                <item name="value" xsi:type="string">3_columns</item>
                                <item name="label" xsi:type="string" translate="true">3 Columns</item>
                            </option>
                            <option name="4" xsi:type="array">
                                <item name="value" xsi:type="string">4_columns</item>
                                <item name="label" xsi:type="string" translate="true">4 Columns</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="mobile_layout" sortOrder="40" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1_column</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Mobile Layout</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="0" xsi:type="array">
                                <item name="value" xsi:type="string">slider</item>
                                <item name="label" xsi:type="string" translate="true">Slider</item>
                            </option>
                            <option name="1" xsi:type="array">
                                <item name="value" xsi:type="string">1_column</item>
                                <item name="label" xsi:type="string" translate="true">1 Column</item>
                            </option>
                            <option name="2" xsi:type="array">
                                <item name="value" xsi:type="string">2_columns</item>
                                <item name="label" xsi:type="string" translate="true">2 Columns</item>
                            </option>
                            <option name="3" xsi:type="array">
                                <item name="value" xsi:type="string">3_columns</item>
                                <item name="label" xsi:type="string" translate="true">3 Columns</item>
                            </option>
                            <option name="4" xsi:type="array">
                                <item name="value" xsi:type="string">4_columns</item>
                                <item name="label" xsi:type="string" translate="true">4 Columns</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
